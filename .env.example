# Copiá este archivo como .env y completá los valores. El .env NO se versiona.
# En producción (Render) estas variables van en el dashboard, con otros valores.

# Conexión a Postgres. Local: postgresql://usuario:contraseña@localhost:5432/nubio
DATABASE_URL=

# Secreto para firmar los JWT (mínimo 32 caracteres). Generarlo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Orígenes que pueden usar la API desde el navegador (CORS), separados por coma, sin barra final.
FRONTEND_URL=http://localhost:5173

# Opcionales
# TRUST_PROXY=3          # cantidad de proxies delante del servidor (Render: 3)
# NODE_ENV=production    # solo en producción
